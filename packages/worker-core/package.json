{
  "name": "@orbital-worker-core",
  "version": "0.1.0",
  "description": "Orbital worker CLI and core",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "commonjs",
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "bin": {
    "orbital": "./bin/orbital-worker",
    "orbital-worker": "./bin/orbital-worker"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/determined-001/orbital_stellar.git",
    "directory": "packages/worker-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run && npm run test:package",
    "test:package": "npm pack --dry-run && npm exec --package=. -- orbital --help",
    "test:types": "tsc --noEmit -p tsconfig.typetest.json",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@orbital-stellar/abi-registry": "workspace:*",
    "@orbital-stellar/pulse-core": "workspace:*",
    "pino": "^8.15.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.0.0",
    "vitest": "^0.34.0"
  }
}