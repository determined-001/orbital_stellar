{
  "name": "@orbital-stellar/worker-core",
  "version": "0.1.0",
  "description": "The worker definition model for Orbital's worker layer - what a worker is, before anything runs one.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/determined-001/orbital_stellar.git",
    "directory": "packages/worker-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm test:types && vitest run",
    "test:types": "tsc --noEmit -p tsconfig.typetest.json",
    "test:integration": "INTEGRATION_TESTS=true vitest run test/integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@orbital-stellar/abi-registry": "workspace:*",
    "@orbital-stellar/pulse-core": "workspace:*",
    "pino": "^8.15.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^4.1.11",
    "pg": "^8.22.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "orbital-worker": "./bin/orbital-worker"
  }
}
