{
  "name": "orbital-next-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js App Router starter: live, typed Stellar events in the browser via React hooks, with the engine and cursor on the server.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
