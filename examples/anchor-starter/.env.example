# A funded testnet account's secret key (S...). `stellar keys generate` +
# Friendbot will fund one - never use a mainnet key here.
STELLAR_SECRET=

# Anchor home domain. Defaults to Stellar Development Foundation's own
# reference anchor, verified live and SEP-1/10/24/31-compliant.
# HOME_DOMAIN=testanchor.stellar.org

# testnet (default) or mainnet.
# STELLAR_NETWORK=testnet

# Asset to deposit/send. Defaults to SRT, the anchor's own test asset.
# ASSET_CODE=SRT
