{
  "name": "orbital/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter \"@orbital-stellar/pulse-core...\" --filter \"@orbital-stellar/pulse-webhooks...\" --filter \"@orbital-stellar/abi-registry...\" run build && pnpm -w run docs:reference && pnpm -w run docs:generate-open-data",
    "dev": "next dev",
    "prebuild": "pnpm --filter \"@orbital-stellar/pulse-core...\" --filter \"@orbital-stellar/pulse-webhooks...\" --filter \"@orbital-stellar/abi-registry...\" run build && pnpm -w run docs:reference && pnpm -w run docs:generate-open-data",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@orbital-stellar/abi-registry": "workspace:*",
    "@orbital-stellar/pulse-core": "workspace:*",
    "@orbital-stellar/pulse-webhooks": "workspace:*",
    "@stellar/stellar-sdk": "^16.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "next": "~16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.0.0",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
